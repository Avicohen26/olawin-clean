{
  "rewrites": [
    { "source": "/disneyland", "destination": "/api/go?c=disneyland" },
    { "source": "/prestige", "destination": "/api/go?c=prestige" },
    { "source": "/ile-maurice", "destination": "/api/go?c=ile-maurice" },
    { "source": "/go/:slug", "destination": "/api/go?c=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron-abandoned-carts", "schedule": "0 9 * * *" }],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ]
}
